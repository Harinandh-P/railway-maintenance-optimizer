# Railway Maintenance Block Optimization System - Environment Configuration Example

# Backend Application Configuration
PORT=8000
ENVIRONMENT=production
SECRET_KEY=YOUR_SECRET_KEY
ADMIN_PASSKEY=YOUR_ADMIN_PASSKEY
TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Supabase PostgreSQL or local SQLite fallback)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.example.supabase.co:5432/postgres
DB_PATH=./data/railway_optimizer.db

# Frontend Application Configuration
VITE_API_BASE_URL=http://127.0.0.1:8000/api
